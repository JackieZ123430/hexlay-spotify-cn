{
  "id": "speed_limit",
  "title": "Speed Limit",
  "description": "The speed limit of the road you're on, on the head-up display and the cluster's map, from an offline OpenStreetMap map of Georgia. Read-only.",
  "version": "1.0.0",
  "vendor": "custom",
  "loggingId": "OASL",
  "iconGlyph": "60",
  "autostart": true,
  "mguHmi": ["ID7"],
  "maxDiskUsage": 41943040,
  "signals": {
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.navigation.positioning.Positioning": {
      "_optional": "the navigation's position (GNSS with the car's dead reckoning); without it the GPS position alone",
      "_instances": "Main_Instance",
      "currentLocation": "rs"
    },
    "de.bmw.infotainment.GPSData": {
      "_optional": "the GPS position; without it the navigation's position alone",
      "GPSPositionCAN": "rs",
      "GPSPositionExtendedCAN": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Speed Limit",
      "buttons": [["BTN_PAGE", "Details"], ["BTN_SETTINGS", "Settings"]]
    }
  ],
  "settings": [
    {"key": "hud", "label": "Head-up display", "type": "choice", "default": "on", "options": [["on", "Show the sign"], ["off", "Off"]]},
    {"key": "hudSize", "label": "HUD sign size", "type": "number", "unit": "px", "default": 88, "steps": [64, 72, 80, 88, 96, 104, 112, 128], "when": {"hud": "on"}},
    {"key": "hudX", "label": "HUD sign: left / right", "type": "number", "unit": "px", "default": 0, "steps": [-200, -160, -120, -80, -60, -40, -20, 0, 20, 40, 60, 80, 120, 160, 200, 260, 320, 380], "when": {"hud": "on"}},
    {"key": "hudY", "label": "HUD sign: up / down", "type": "number", "unit": "px", "default": 0, "steps": [-160, -120, -80, -60, -40, -20, 0, 20, 40, 60], "when": {"hud": "on"}},
    {"key": "cluster", "label": "Instrument cluster", "type": "choice", "default": "map", "options": [["map", "With the phone map (Maps on cluster)"], ["always", "Always (takes the cluster's centre)"], ["off", "Off"]]},
    {"key": "clusterSize", "label": "Cluster sign size", "type": "number", "unit": "px", "default": 110, "steps": [80, 96, 110, 128, 144, 160], "when": {"cluster": ["map", "always"]}},
    {"key": "clusterX", "label": "Cluster sign: left / right", "type": "number", "unit": "px", "default": 0, "steps": [0, 40, 80, 160, 240, 320, 480, 640, 800, 920], "when": {"cluster": ["map", "always"]}},
    {"key": "clusterY", "label": "Cluster sign: up / down", "type": "number", "unit": "px", "default": 0, "steps": [0, 40, 80, 120, 200, 280, 320], "when": {"cluster": ["map", "always"]}},
    {"key": "overspeed", "label": "Over the limit: red sign from", "type": "choice", "default": "0", "options": [["0", "Off"], ["5", "+5 km/h"], ["10", "+10 km/h"], ["15", "+15 km/h"]]},
    {"key": "untagged", "label": "Roads without a limit on the map", "type": "choice", "default": "show", "options": [["show", "Show the default (grey ring)"], ["hide", "Show nothing"]]},
    {"key": "defUrban", "label": "Default in a settlement", "type": "number", "unit": "km/h", "default": 60, "markDefault": true, "steps": [40, 50, 60, 70, 80], "when": {"untagged": "show"}},
    {"key": "defRural", "label": "Default outside settlements", "type": "number", "unit": "km/h", "default": 90, "markDefault": true, "steps": [70, 80, 90, 100, 110], "when": {"untagged": "show"}},
    {"key": "defMotorway", "label": "Default on motorways", "type": "number", "unit": "km/h", "default": 110, "markDefault": true, "steps": [90, 100, 110, 120, 130], "when": {"untagged": "show"}},
    {"key": "defLiving", "label": "Default in living streets", "type": "number", "unit": "km/h", "default": 20, "markDefault": true, "steps": [10, 20, 30], "when": {"untagged": "show"}},
    {"key": "record", "label": "Record drives (for tuning)", "type": "choice", "default": "off", "options": [["off", "Off"], ["on", "On (last 5 drives, in the app's data)"]]}
  ]
}
