{
  "schema": 1,
  "components": [
    {
      "id": "spotify",
      "kind": "app",
      "path": "apps/spotify",
      "manifest": "app.zh-CN.json",
      "title": "Spotify",
      "description": "BMW iDrive 7 的 Spotify Connect 播放控制和曲库浏览应用",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0",
        "mgu-uplink": "0.7.3"
      },
      "icon": "icon.png",
      "build": {
        "python": "localization/build_zh_cn.py",
        "args": [
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "kit",
          "apps",
          "localization"
        ]
      }
    }
  ],
  "tools": []
}
